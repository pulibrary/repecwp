#!/usr/bin/env ruby

# This script is responsible for setting up secret development credentials
# on your machine in a .env.local file

require 'pathname'

ROOT_DIR = Pathname.new(__FILE__).dirname.parent

File.open("#{ROOT_DIR}/.env.local", 'w') do |file|
    `lpass show --notes "Shared-ITIMS-Passwords/repecwp-entraid-dev"`
        .then { |raw| raw.split("\n") }
        .select { |line| line =~ /^[A-Z_]+=[^\s]+$/ }
        .then { file.puts it }
end
